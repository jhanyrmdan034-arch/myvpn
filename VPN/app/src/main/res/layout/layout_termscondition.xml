<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorPrimary">
    <ImageView
        android:id="@+id/maps_iv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:src="@drawable/login_bg"
        />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_12dp">

                <ImageView
                    android:id="@+id/iv_close_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxHeight="20dp"
                    android:maxWidth="20dp"
                    android:layout_marginStart="5dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/back"
                    android:layout_marginLeft="10dp" />
                <TextView
                    android:id="@+id/title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text="title"
                    android:fontFamily="@font/poppins_bold"
                    android:drawablePadding="@dimen/_6dp"
                    android:layout_centerInParent="true"
                    android:textColor="@color/text_color"
                    android:textSize="18sp"/>
            </RelativeLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="@dimen/_12dp"
                android:paddingRight="@dimen/_12dp">


                    <TextView
                        android:id="@+id/des_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="VIP-specific features"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#5E5C5C"
                        />

            </ScrollView>

        </LinearLayout>





</RelativeLayout>